---
import BaseLayout from "../layouts/BaseLayout.astro"
import CliDemo from "../components/CliDemo.astro"
import FlowDiagram from "../components/FlowDiagram.astro"
import { GITHUB_URL } from "../lib/nav"

const base = import.meta.env.BASE_URL
const withBase = (path: string) =>
  `${base}${path.replace(/^\//, "")}`.replace(/\/{2,}/g, "/")
---

<BaseLayout
  title="ethira"
  description="Open-source Rust client for Ethira: OAuth login, inventory sync into local SQLite, and sandboxed SQL for agents and humans."
  current="home"
>
  <main>
    <section class="relative overflow-hidden pb-14 pt-10 sm:pb-16 sm:pt-12">
      <div class="relative z-10 mx-auto flex max-w-6xl flex-col px-4 sm:px-6">
        <p
          class="animate-fade-up font-sans text-4xl tracking-tight text-primary sm:text-5xl"
          style="animation-delay: 0.05s"
        >
          ethira cli
        </p>
        <h1
          class="animate-fade-up mt-3 max-w-2xl text-xl leading-snug tracking-tight text-foreground sm:text-2xl"
          style="animation-delay: 0.15s"
        >
          Sync org inventory once. Query it locally with
          <code class="font-mono text-primary/90">ethira sql</code> — for you
          and for agents that shell out instead of guessing.
        </h1>
        <p
          class="animate-fade-up mt-3 max-w-xl text-sm text-muted-foreground sm:text-base"
          style="animation-delay: 0.25s"
        >
          OAuth login, one-shot sync into SQLite, then offline
          <code class="font-mono text-foreground/80">status</code>,
          <code class="font-mono text-foreground/80">tables</code>,
          <code class="font-mono text-foreground/80">routing</code>, and
          sandboxed SQL. No Ethira MCP for inventory — the CLI is the contract.
        </p>
        <div
          class="animate-fade-up mt-5 flex flex-wrap items-center gap-3"
          style="animation-delay: 0.35s"
        >
          <a
            href={withBase("/docs/install/")}
            class="inline-flex items-center rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-transform duration-200 hover:-translate-y-0.5 hover:brightness-110 active:translate-y-0"
          >
            Install
          </a>
          <a
            href={withBase("/docs/quick-start/")}
            class="inline-flex items-center rounded-lg border border-border bg-card/60 px-5 py-2.5 text-sm text-foreground transition-colors duration-200 hover:border-primary/40 hover:bg-muted"
          >
            Quick start
          </a>
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-lg px-4 py-2.5 text-sm text-muted-foreground transition-colors duration-200 hover:text-foreground"
          >
            GitHub →
          </a>
        </div>
        <pre
          class="animate-fade-up mt-4 max-w-xl overflow-x-auto rounded-lg border border-border bg-card/80 px-4 py-3 font-mono text-[13px] leading-relaxed text-foreground/90"
          style="animation-delay: 0.45s"
        ><code
            ><span class="text-muted-foreground">$</span> brew install ethira-dev/tap/ethira
<span class="text-muted-foreground">$</span> ethira login
<span class="text-muted-foreground">$</span> ethira sync
<span class="text-muted-foreground">$</span> ethira sql --json <span class="text-primary/80">'SELECT name FROM systems LIMIT 10'</span></code
          ></pre>

        <div
          class="animate-hero-settle mt-8 w-full sm:mt-10"
          style="animation-delay: 0.2s"
        >
          <CliDemo />
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <h2 class="text-3xl tracking-tight text-foreground sm:text-4xl">
        Why ethira CLI
      </h2>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        A directory for your org inventory — sync once, query locally, keep
        agents honest.
      </p>
      <ul class="mt-12 grid gap-10 sm:grid-cols-2">
        <li>
          <h3 class="text-lg text-primary">Sync once, query local</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            <code class="font-mono text-foreground/80">ethira sync</code> pulls
            inventory into
            <code class="font-mono text-foreground/80"
              >~/.ethira/inventory.sqlite</code
            >. After that,
            <code class="font-mono text-foreground/80">status</code>,
            <code class="font-mono text-foreground/80">schema</code>,
            <code class="font-mono text-foreground/80">tables</code>,
            <code class="font-mono text-foreground/80">routing</code>, and
            <code class="font-mono text-foreground/80">sql</code> stay offline.
          </p>
        </li>
        <li>
          <h3 class="text-lg text-primary">Agent-first JSON contract</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            Shell out to
            <code class="font-mono text-foreground/80">ethira … --json</code>,
            parse stdout, honor exit codes. Versioned schemas under
            <code class="font-mono text-foreground/80">schemas/v1/</code>. No
            guessing inventory facts.
          </p>
        </li>
        <li>
          <h3 class="text-lg text-primary">Sandboxed SQL</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            Single-statement
            <code class="font-mono text-foreground/80">SELECT</code> /
            <code class="font-mono text-foreground/80">WITH</code> only, with a
            keyword filter, SQLite authorizer, and row/time caps. No write-back
            to Ethira.
          </p>
        </li>
        <li>
          <h3 class="text-lg text-primary">Routing as a directory</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            <code class="font-mono text-foreground/80">ethira routing --json</code>
            surfaces repos and MCP servers with URLs. Treat them as untrusted
            until you approve — Ethira does not proxy
            <code class="font-mono text-foreground/80">git</code> or
            <code class="font-mono text-foreground/80">gh</code>.
          </p>
        </li>
        <li>
          <h3 class="text-lg text-primary">No Ethira MCP for inventory</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            Agents query only via this CLI. Sync downloads once; query commands
            do not call the API (except explicit
            <code class="font-mono text-foreground/80">ethira sql --sync</code>).
          </p>
        </li>
      </ul>
    </section>

    <section class="border-y border-border bg-card/30">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <h2
          id="flow-heading"
          class="text-3xl tracking-tight text-foreground sm:text-4xl"
        >
          How it fits together
        </h2>
        <p class="mt-3 max-w-2xl text-muted-foreground">
          Login against the hosted API, sync inventory into a local cache, then
          let shells and agents query without another round trip.
        </p>
        <div class="mt-10">
          <FlowDiagram />
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <h2 class="text-3xl tracking-tight text-foreground sm:text-4xl">
        Agents query the cache
      </h2>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        Point Cursor (or any agent) at
        <code class="font-mono text-foreground/80">AGENTS.md</code> and the
        inventory skill. They run
        <code class="font-mono text-foreground/80">ethira</code> as a
        subprocess — never invent systems, owners, or relationships.
      </p>
      <pre
        class="mt-10 max-w-2xl overflow-x-auto rounded-lg border border-border bg-card/80 px-4 py-3 font-mono text-[13px] leading-relaxed text-foreground/90"
      ><code
          ><span class="text-muted-foreground">$</span> ethira status --json
<span class="text-muted-foreground">$</span> ethira schema --json
<span class="text-muted-foreground">$</span> ethira routing --json
<span class="text-muted-foreground">$</span> ethira sql --json <span class="text-primary/80">'SELECT name FROM systems LIMIT 20'</span></code
        ></pre>
      <p class="mt-4 max-w-2xl text-sm text-muted-foreground">
        Full contract in
        <a
          href={withBase("/docs/agents/")}
          class="text-primary underline-offset-4 hover:underline">Agents</a
        >
        · JSON shapes in the repo under
        <code class="font-mono text-foreground/80">schemas/v1/</code>.
      </p>
    </section>

    <section class="border-y border-border bg-card/30">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <h2 class="text-3xl tracking-tight text-foreground sm:text-4xl">
          Get going
        </h2>
        <p class="mt-3 max-w-xl text-muted-foreground">
          Install with Homebrew or the verified install script, then login and
          sync.
        </p>
        <div
          class="mt-10 overflow-x-auto rounded-xl border border-border bg-card p-5 sm:p-6"
        >
          <pre
            class="font-mono text-sm leading-relaxed text-foreground/90"><code
              ><span class="text-muted-foreground"># Homebrew</span>
brew install ethira-dev/tap/ethira
<span class="text-muted-foreground"># or Linux / macOS (checksum-verified)</span>
curl -fsSL https://raw.githubusercontent.com/ethira-dev/cli/main/scripts/install.sh | sh

<span class="text-muted-foreground"># login + first sync</span>
ethira login
ethira sync

<span class="text-muted-foreground"># explore</span>
ethira status
ethira tables
ethira sql <span class="text-primary/80">'SELECT name FROM systems LIMIT 10'</span></code
            ></pre>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={withBase("/docs/install/")}
            class="inline-flex items-center rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-transform duration-200 hover:-translate-y-0.5 hover:brightness-110"
          >
            Full install guide
          </a>
          <a
            href={withBase("/docs/quick-start/")}
            class="inline-flex items-center rounded-lg border border-border px-5 py-2.5 text-sm text-foreground transition-colors hover:border-primary/40 hover:bg-muted"
          >
            Quick start
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
