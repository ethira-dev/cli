{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethira.dev/schemas/cli/v1/sql.json",
  "title": "ethira sql --json",
  "type": "object",
  "required": ["schemaVersion", "columns", "rows"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": "1" },
    "localOnly": { "type": "boolean" },
    "columns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
